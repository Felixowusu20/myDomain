    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
